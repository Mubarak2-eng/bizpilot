// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum Role {
  OWNER
  ADMIN
  STAFF
  MEMBER
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
  MOBILE_MONEY
  CREDIT
}

enum CreditStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  OVERDUE
}

enum SaleStatus {
  PENDING
  COMPLETED
  CANCELLED
  REFUNDED
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  CANCELLED
}

enum BusinessType {
  RETAIL
  RESTAURANT
  PHARMACY
  FASHION
  ELECTRONICS
  SALON
  SUPERMARKET
  OTHER
}

enum NotificationType {
  LOW_STOCK
  SYSTEM
}

enum CampaignStatus {
  DRAFT
  SENDING
  SENT
  PARTIALLY_SENT
  FAILED
}

enum RecipientStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

enum PlanCode {
  FREE
  STARTER
  PRO
  BUSINESS
}

enum GoalType {
  MONTHLY_REVENUE
  MONTHLY_PROFIT
  INVENTORY_TURNOVER
  RECEIVABLES_COLLECTION
  CUSTOMER_GROWTH
}

// ─── User ────────────────────────────────────────────────────────────────────

model User {
  id            String       @id @default(cuid())
  name          String?
  email         String       @unique
  emailVerified DateTime?
  image         String?
  password      String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  accounts            Account[]
  sessions            Session[]
  memberships         Membership[]
  whatsAppConnections WhatsAppConnection[]
  loginPins           LoginPin[]
  aiPendingActions    AIPendingAction[]

  @@index([email])
}

// ─── Business ────────────────────────────────────────────────────────────────

model Business {
  id           String       @id @default(cuid())
  name         String
  slug         String       @unique
  businessType BusinessType @default(OTHER)
  currency     String       @default("NGN")
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  memberships                  Membership[]
  products                     Product[]
  customers                    Customer[]
  sales                        Sale[]
  expenses                     Expense[]
  invoices                     Invoice[]
  whatsAppConnections          WhatsAppConnection[]
  subscription                 Subscription?
  payments                     Payment[]
  creditPayments               CreditPayment[]
  notifications                Notification[]
  customerCampaigns            CustomerCampaign[]
  aiUsages                     AIUsage[]
  goals                        BusinessGoal[]
  whatsAppProcessedMessages    WhatsAppProcessedMessage[]
  whatsAppConversationSessions WhatsAppConversationSession[]
  aiPendingActions             AIPendingAction[]

  @@index([slug])
}

// ─── Membership (multi-tenancy pivot) ────────────────────────────────────────

model Membership {
  id         String   @id @default(cuid())
  userId     String
  businessId String
  role       Role     @default(MEMBER)
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([userId, businessId])
  @@index([businessId])
  @@index([userId])
}

// ─── Product ─────────────────────────────────────────────────────────────────

model Product {
  id                String   @id @default(cuid())
  businessId        String
  name              String
  sku               String
  barcode           String?
  description       String?
  sellingPrice      Decimal  @db.Decimal(12, 2)
  costPrice         Decimal  @db.Decimal(12, 2)
  stockQuantity     Int      @default(0)
  lowStockThreshold Int      @default(10)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  business      Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  saleItems     SaleItem[]
  invoiceItems  InvoiceItem[]
  notifications Notification[]

  @@unique([businessId, sku])
  @@unique([businessId, barcode])
  @@index([businessId])
}

// ─── Customer ────────────────────────────────────────────────────────────────

model Customer {
  id         String   @id @default(cuid())
  businessId String
  name       String
  phone      String?
  email      String?
  address    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business           Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  sales              Sale[]
  invoices           Invoice[]
  campaignRecipients CampaignRecipient[]

  @@index([businessId])
  @@index([businessId, email])
  @@index([businessId, phone])
}

// ─── Sale ────────────────────────────────────────────────────────────────────

model Sale {
  id                 String        @id @default(cuid())
  businessId         String
  customerId         String?
  totalAmount        Decimal       @db.Decimal(12, 2)
  paymentMethod      PaymentMethod
  status             SaleStatus    @default(COMPLETED)
  isCredit           Boolean       @default(false)
  creditDueDate      DateTime?
  creditStatus       CreditStatus?
  amountPaid         Decimal       @default(0) @db.Decimal(12, 2)
  outstandingBalance Decimal       @default(0) @db.Decimal(12, 2)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  business       Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer       Customer?       @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items          SaleItem[]
  creditPayments CreditPayment[]

  @@index([businessId])
  @@index([businessId, createdAt])
  @@index([businessId, isCredit])
  @@index([businessId, creditStatus])
  @@index([customerId])
}

// ─── CreditPayment ───────────────────────────────────────────────────────────

model CreditPayment {
  id            String        @id @default(cuid())
  saleId        String
  businessId    String
  amount        Decimal       @db.Decimal(12, 2)
  paymentMethod PaymentMethod @default(CASH)
  note          String?
  recordedBy    String?
  createdAt     DateTime      @default(now())

  sale     Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([saleId])
  @@index([businessId])
  @@index([businessId, createdAt])
}

// ─── Notification ────────────────────────────────────────────────────────────

model Notification {
  id         String           @id @default(cuid())
  businessId String
  type       NotificationType @default(LOW_STOCK)
  title      String
  message    String
  read       Boolean          @default(false)
  productId  String?
  createdAt  DateTime         @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  product  Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([businessId])
  @@index([businessId, read])
  @@index([businessId, createdAt])
}

// ─── LoginPin (Email Verification Challenge) ─────────────────────────────────

model LoginPin {
  id                  String    @id @default(cuid())
  userId              String
  email               String
  pinHash             String
  expiresAt           DateTime
  attempts            Int       @default(0)
  maxAttempts         Int       @default(5)
  resendCooldownUntil DateTime
  consumedAt          DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([email])
  @@index([expiresAt])
}

// ─── CustomerCampaign ────────────────────────────────────────────────────────

model CustomerCampaign {
  id             String         @id @default(cuid())
  businessId     String
  createdBy      String
  subject        String
  body           String         @db.Text
  status         CampaignStatus @default(DRAFT)
  recipientCount Int            @default(0)
  sentCount      Int            @default(0)
  failedCount    Int            @default(0)
  createdAt      DateTime       @default(now())
  sentAt         DateTime?
  updatedAt      DateTime       @updatedAt

  business   Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  recipients CampaignRecipient[]

  @@index([businessId])
  @@index([businessId, status])
  @@index([businessId, createdAt])
}

// ─── CampaignRecipient ───────────────────────────────────────────────────────

model CampaignRecipient {
  id           String          @id @default(cuid())
  campaignId   String
  customerId   String?
  email        String
  status       RecipientStatus @default(PENDING)
  errorMessage String?
  sentAt       DateTime?
  createdAt    DateTime        @default(now())

  campaign CustomerCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  customer Customer?         @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([campaignId])
  @@index([campaignId, status])
  @@index([customerId])
}

// ─── SaleItem ────────────────────────────────────────────────────────────────

model SaleItem {
  id          String  @id @default(cuid())
  saleId      String
  productId   String
  quantity    Int
  unitPrice   Decimal @db.Decimal(12, 2)
  totalAmount Decimal @db.Decimal(12, 2)

  sale    Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([saleId])
  @@index([productId])
}

// ─── Expense ─────────────────────────────────────────────────────────────────

model Expense {
  id          String   @id @default(cuid())
  businessId  String
  category    String
  description String?
  amount      Decimal  @db.Decimal(12, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([businessId, category])
  @@index([businessId, createdAt])
}

// ─── Invoice ─────────────────────────────────────────────────────────────────

model Invoice {
  id            String        @id @default(cuid())
  businessId    String
  customerId    String
  invoiceNumber String
  status        InvoiceStatus @default(DRAFT)
  subtotal      Decimal       @db.Decimal(12, 2)
  tax           Decimal       @db.Decimal(12, 2) @default(0)
  total         Decimal       @db.Decimal(12, 2)
  dueDate       DateTime
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  business Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  items    InvoiceItem[]

  @@unique([businessId, invoiceNumber])
  @@index([businessId])
  @@index([businessId, status])
  @@index([customerId])
}

// ─── InvoiceItem ─────────────────────────────────────────────────────────────

model InvoiceItem {
  id          String  @id @default(cuid())
  invoiceId   String
  productId   String?
  description String
  quantity    Int
  unitPrice   Decimal @db.Decimal(12, 2)
  totalAmount Decimal @db.Decimal(12, 2)

  invoice Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([invoiceId])
  @@index([productId])
}

// ─── Auth.js Models ─────────────────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── WhatsApp Integration ───────────────────────────────────────────────────

model WhatsAppConnection {
  id                      String    @id @default(cuid())
  phoneNumber             String    @unique // E.164 without '+' e.g. "2348012345678"
  userId                  String
  businessId              String
  verified                Boolean   @default(false)
  verificationCodeHash    String?
  verificationExpiresAt   DateTime?
  verificationAttempts    Int       @default(0)
  verificationRequestedAt DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([phoneNumber])
  @@index([businessId])
  @@index([userId])
}

// ─── Subscription & Commercialization Models ────────────────────────────────

model Plan {
  id             String       @id @default(cuid())
  code           PlanCode     @unique
  name           String
  description    String?
  monthlyPrice   Decimal      @db.Decimal(12, 2)
  currency       String       @default("NGN")
  aiMonthlyLimit Int
  maxStaff       Int          @default(5)
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  subscriptions Subscription[]

  @@index([code])
}

model Subscription {
  id                       String             @id @default(cuid())
  businessId               String             @unique
  planId                   String
  status                   SubscriptionStatus @default(TRIALING)
  paystackCustomerCode     String?
  paystackSubscriptionCode String?
  paystackPlanCode         String?
  currentPeriodStart       DateTime           @default(now())
  currentPeriodEnd         DateTime
  trialEndsAt              DateTime?
  cancelledAt              DateTime?
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt

  business Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  plan     Plan      @relation(fields: [planId], references: [id], onDelete: Restrict)
  payments Payment[]

  @@index([businessId])
  @@index([planId])
  @@index([status])
}

model Payment {
  id                String        @id @default(cuid())
  businessId        String
  subscriptionId    String?
  paystackReference String        @unique
  amount            Decimal       @db.Decimal(12, 2)
  currency          String        @default("NGN")
  status            String
  eventType         String
  metadata          Json?
  createdAt         DateTime      @default(now())

  business     Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@index([businessId])
  @@index([paystackReference])
  @@index([subscriptionId])
}

model AIUsage {
  id         String   @id @default(cuid())
  businessId String
  periodKey  String   // e.g. "2026-08"
  queryCount Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, periodKey])
  @@index([businessId])
  @@index([businessId, periodKey])
}

// ─── Business Goals ─────────────────────────────────────────────────────────

model BusinessGoal {
  id           String    @id @default(cuid())
  businessId   String
  type         GoalType
  targetValue  Decimal   @db.Decimal(12, 2)
  currentValue Decimal   @db.Decimal(12, 2) @default(0)
  currency     String    @default("NGN")
  periodKey    String    // e.g. "2026-08"
  startDate    DateTime  @default(now())
  endDate      DateTime
  isAchieved   Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, type, periodKey])
  @@index([businessId])
  @@index([businessId, periodKey])
}

// ─── WhatsApp Processed Messages (Serverless Deduplication) ─────────────────

model WhatsAppProcessedMessage {
  id         String   @id @default(cuid())
  messageId  String   @unique
  businessId String?
  createdAt  DateTime @default(now())

  business Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@index([createdAt])
  @@index([businessId])
}

// ─── WhatsApp Conversation Sessions (Serverless State) ──────────────────────

model WhatsAppConversationSession {
  id                String   @id @default(cuid())
  phoneNumber       String   @unique
  businessId        String?
  activeActionToken String?
  history           Json     @default("[]")
  lastActivity      DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  business Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([phoneNumber])
  @@index([businessId])
  @@index([lastActivity])
}

// ─── AI Pending Actions (Serverless Confirmation Vouchers) ──────────────────

model AIPendingAction {
  id         String    @id @default(cuid())
  token      String    @unique
  userId     String
  businessId String
  actionType String
  payload    Json
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
  @@index([businessId])
  @@index([expiresAt])
}

