# ==============================================================================
# BIZPILOT AI — ENVIRONMENT CONFIGURATION (.env.example)
# ==============================================================================

# ── 1. Database (REQUIRED in Production) ──────────────────────────────────────
# PostgreSQL connection string with connection pooling
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public&connection_limit=20
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD_HERE@localhost:5432/bizpilot?schema=public"

# ── 2. Authentication & Security (REQUIRED in Production) ─────────────────────
# Auth.js / NextAuth v5 32-byte secret key (generate with: openssl rand -base64 32)
AUTH_SECRET="generate-a-secure-32-byte-hex-or-base64-secret"

# Canonical URL of your deployment (Optional: Auto-detected on Vercel/Railway)
# AUTH_URL="https://app.bizpilot.ai"

# Optional dedicated OTP salt (Falls back to AUTH_SECRET if omitted)
# OTP_SECRET_KEY="generate-a-secure-32-byte-secret"

# ── 3. Background Scheduled Jobs (REQUIRED in Production for Cron) ───────────
# Shared secret for triggering POST /api/cron/morning-brief
CRON_SECRET="generate-a-secure-32-byte-cron-secret"

# ── 4. Paystack Payments & Subscriptions (REQUIRED for Live Billing) ──────────
# Secret key from Paystack Dashboard -> Settings -> API Keys & Webhooks
PAYSTACK_SECRET_KEY="sk_live_..."
PAYSTACK_PUBLIC_KEY="pk_live_..."

# ── 5. WhatsApp Business Cloud API (REQUIRED for Live WhatsApp Bot) ───────────
# Meta for Developers -> WhatsApp -> API Setup
WHATSAPP_ACCESS_TOKEN="EAAB..."
WHATSAPP_PHONE_NUMBER_ID="109876543210987"
WHATSAPP_APP_SECRET="0123456789abcdef0123456789abcdef"
WHATSAPP_VERIFY_TOKEN="bizpilot_wa_verify_secret_2026"
WHATSAPP_API_VERSION="v21.0"

# ── 6. Optional External AI LLM (OPTIONAL) ────────────────────────────────────
# Built-in local deterministic Copilot engine is used if omitted
OPENAI_API_KEY="sk-..."
